{
  "name": "parallel",
  "version": "1.0.0",
  "description": "A project to showcase running tests in parallel using Vibium",
  "license": "MIT",
  "scripts": {
    "pretest": "vibium install",
    "test": "mocha test/**/*.spec.js --timeout 60000 --parallel --jobs 2"
  },
  "dependencies": {
    "vibium": "26.8.21"
  },
  "devDependencies": {
    "mocha": "12.0.3"
  }
}
